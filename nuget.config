<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, whatever feeds the machine's own NuGet configuration adds, and map every
  package to it (package source mapping), so a package name can never be satisfied from another feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
