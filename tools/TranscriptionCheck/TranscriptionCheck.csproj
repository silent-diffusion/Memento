<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual end-to-end check of M2 on real models and hardware: installs models through the model manager, imports a
    WAV as a recording and runs the real orchestrator (transcript, speakers, topics) with the real worker. Uses the
    data root in LOCALAPPDATA, so point LOCALAPPDATA at a scratch folder. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Memento.Tools.TranscriptionCheck</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Memento.Core\Memento.Core.csproj" />
    <ProjectReference Include="..\..\src\Memento.Transcription\Memento.Transcription.csproj" />
  </ItemGroup>

</Project>
