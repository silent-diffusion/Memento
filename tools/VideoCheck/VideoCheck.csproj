<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual measurements of the video layer on real hardware (ENGINE-NOTES.md §M): capture, encode, sync, crash. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Memento.Tools.VideoCheck</RootNamespace>
    <AssemblyName>VideoCheck</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Memento.Video\Memento.Video.csproj" />
  </ItemGroup>

</Project>
