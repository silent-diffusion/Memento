<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <!-- Pinned so every SDK (local 8.0 band, newer CI images) runs the same rules; build-time only. -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
  </ItemGroup>
  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup Label="Core">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>
  <ItemGroup Label="Audio">
    <PackageVersion Include="NAudio.Core" Version="2.4.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup Label="Worker">
    <!-- Whisper.net with the CPU and Vulkan runtimes only: no CUDA package (ENGINE-NOTES.md §D). -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- The Visual C++ runtime DLLs the Whisper.net native libraries import, shipped app-locally beside the worker. -->
    <PackageVersion Include="NtvLibs.MSVCP.vcruntime140.runtime.win-x64" Version="14.42.34430" />
    <PackageVersion Include="NtvLibs.MSVCP.vcruntime140_1.runtime.win-x64" Version="14.42.34430" />
    <PackageVersion Include="NtvLibs.MSVCP.msvcp140.runtime.win-x64" Version="14.42.34430" />
    <PackageVersion Include="NtvLibs.MSVCP.vcomp140.runtime.win-x64" Version="14.42.34430" />
  </ItemGroup>
  <ItemGroup Label="Documents">
    <!-- Agenda import: Word and Excel files (MIT) and PDF text with positions (Apache-2.0); both pure managed. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
