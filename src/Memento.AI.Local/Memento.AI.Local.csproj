<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The local LLM engine (ARCHITECTURE.md section 8, ENGINE-NOTES.md section H): LLamaSharp 0.27 over llama.cpp with
    the Windows Vulkan backend and the CPU backend, referenced directly (the LLamaSharp.Backend.Vulkan meta-package
    adds 65 MB of Linux binaries). Only Memento.Worker loads this assembly; the app talks to it through the job
    protocol in Memento.AI, so native failures and video memory stay in the worker process. LLamaSharp brings
    Microsoft.Extensions.* and System.Text.Json 10, which is why it is kept out of Memento.AI.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Memento.AI.Local</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Only the win-x64 native libraries are copied (without a RID the CPU backend copies every platform). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memento.AI\Memento.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Memento.AI.Tests" />
  </ItemGroup>

</Project>
