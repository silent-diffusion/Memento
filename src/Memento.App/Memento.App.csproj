<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Memento.App</RootNamespace>
    <AssemblyName>Memento</AssemblyName>
    <AssemblyTitle>Memento</AssemblyTitle>
    <StartupObject>Memento.App.Program</StartupObject>
    <ApplicationIcon>..\..\build\icons\memento.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport source generation (SingleInstanceGuard) emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memento.Core\Memento.Core.csproj" />
    <ProjectReference Include="..\Memento.Audio\Memento.Audio.csproj" />
    <ProjectReference Include="..\Memento.Documents\Memento.Documents.csproj" />
    <ProjectReference Include="..\Memento.Transcription\Memento.Transcription.csproj" />
    <!-- Built first, but not referenced: the worker runs as its own process from the "worker" folder (below). -->
    <ProjectReference Include="..\Memento.Worker\Memento.Worker.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    Memento.Worker.exe lives in <app>\worker\ with its own dependencies (Whisper.net brings System.Text.Json 10 and
    Microsoft.Extensions.AI, which must not replace the app's own assemblies). A build copies the worker's build
    output there; a publish publishes the worker self-contained there, so Velopack packs it with the app.
  -->
  <Target Name="MementoCopyWorker" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Memento.Worker\Memento.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_MementoWorkerTarget" />
    </MSBuild>
    <PropertyGroup>
      <_MementoWorkerDir>@(_MementoWorkerTarget->'%(RootDir)%(Directory)')</_MementoWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_MementoWorkerFile Include="$(_MementoWorkerDir)**\*" Exclude="$(_MementoWorkerDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_MementoWorkerFile)" DestinationFiles="@(_MementoWorkerFile->'$(OutDir)worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- A separate dotnet process, so the worker restores its own self-contained runtime pack. -->
  <Target Name="MementoPublishWorker" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_MementoDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_MementoDotnet>
      <_MementoDotnet Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</_MementoDotnet>
      <_MementoWorkerPublishDir>$([MSBuild]::NormalizeDirectory('$(PublishDir)', 'worker'))</_MementoWorkerPublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_MementoWorkerPublishDir)" />
    <Exec Command="&quot;$(_MementoDotnet)&quot; publish &quot;$(MSBuildThisFileDirectory)..\Memento.Worker\Memento.Worker.csproj&quot; -c $(Configuration) -r win-x64 --self-contained -p:PublishReadyToRun=false -p:DebugType=none -o &quot;$(_MementoWorkerPublishDir.TrimEnd('\'))&quot; --nologo -v:minimal" />
  </Target>

  <ItemGroup>
    <Resource Include="..\..\build\icons\memento.ico" Link="memento.ico" />
  </ItemGroup>

  <!--
    The interface is the Vite build in ui/dist. It is copied to <output>/ui and served to WebView2
    through the https://app.memento/ virtual host. Build it first: cd ui && npm ci && npm run build
  -->
  <PropertyGroup>
    <MementoUiDist>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'ui', 'dist'))</MementoUiDist>
  </PropertyGroup>

  <Target Name="MementoIncludeUi" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MementoUiDist)index.html')"
           Code="MEMENTO001"
           Text="The interface has not been built: '$(MementoUiDist)index.html' is missing. Run 'npm ci' and then 'npm run build' in the ui folder, then build Memento.App again." />
    <!-- Vite names assets by content hash; start from an empty output ui folder so old bundles never linger. -->
    <RemoveDir Directories="$(OutDir)ui" />
    <ItemGroup>
      <_MementoUiFile Include="$(MementoUiDist)**\*" />
      <Content Include="@(_MementoUiFile)"
               Link="ui\%(_MementoUiFile.RecursiveDir)%(_MementoUiFile.Filename)%(_MementoUiFile.Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
