<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Memento.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Memento.Core.Tests" />
    <InternalsVisibleTo Include="Memento.Transcription" />
    <InternalsVisibleTo Include="Memento.Transcription.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model manager's built-in catalog (Memento.Core.Models.catalog.json). -->
    <EmbeddedResource Include="Models\catalog.json" LogicalName="Memento.Core.Models.catalog.json" />
  </ItemGroup>

</Project>
