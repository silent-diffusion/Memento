<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transcription and speaker identification: the host-side stages (which run every engine in Memento.Worker.exe)
    and the engine-independent algorithms the worker uses (word building, windows and seams, speech energy,
    speaker assignment). No native packages here: Whisper.net and sherpa-onnx are referenced by Memento.Worker only.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Memento.Transcription</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memento.Core\Memento.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Memento.Transcription.Tests" />
  </ItemGroup>

</Project>
