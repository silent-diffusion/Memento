<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Memento.Generation.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Memento.Generation\Memento.Generation.csproj" />
    <!-- The live transcript, for the 2.0 network check (security audit 2). -->
    <ProjectReference Include="..\..\src\Memento.Transcription\Memento.Transcription.csproj" />
  </ItemGroup>

  <!-- The Core test host and fakes, shared rather than copied (as Memento.Transcription.Tests does). -->
  <ItemGroup>
    <Compile Include="..\Memento.Core.Tests\Fakes\*.cs" LinkBase="Fakes" />  </ItemGroup>

  <!-- 2.5.0: the fake OpenAI-compatible server ("Your own server"), shared with Memento.AI.Tests rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Memento.AI.Tests\Fakes\FakeOpenAiCompatibleServer.cs" Link="Fakes\FakeOpenAiCompatibleServer.cs" />
    <Compile Include="..\Memento.AI.Tests\Fakes\ServerPersonality.cs" Link="Fakes\ServerPersonality.cs" />
    <Compile Include="..\Memento.AI.Tests\Fakes\ScriptedResponse.cs" Link="Fakes\ScriptedResponse.cs" />
    <Compile Include="..\Memento.AI.Tests\Fakes\RecordedRequest.cs" Link="Fakes\RecordedRequest.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The walk over a JSON context's types for the null-member checks (security audit 2, section 9). -->
    <Compile Include="..\Memento.Core.Tests\Serialization\NonNullableContracts.cs" Link="Serialization\NonNullableContracts.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
