          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "kind": "text",
                  "text": "The team approved the library layout for build with two changes: rows stay at 68 px with status pills shown only for stages that have run, and the processing card hides whenever a filter or search is active."
                },
                {
                  "kind": "timestamp",
                  "text": "18:42",
                  "t": 1122
                },
                {
                  "kind": "text",
                  "text": " The dark theme will ship with the first version rather than following later."
                },
                {
                  "kind": "timestamp",
                  "text": "41:10",
                  "t": 2470
                },
                {
                  "kind": "text",
                  "text": " The empty state needs copy; Sam owns it."
                }
              ]
            }
          ]
        }
      ]
    },
